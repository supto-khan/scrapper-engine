# ==============================================================================
# Nexidant Signal — Environment Configuration
# ==============================================================================

# Database (MySQL / MariaDB — VPS native aaPanel setup)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nexidant_signal

# Redis (Deduplication, Tier-2 Crawl Queue, Retry Queue & Warmup Limits)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Proxies (Bright Data / Smartproxy residential pools)
USE_PROXIES=false
PROXY_URL=

# Scrapy & Crawling Settings
CONCURRENT_REQUESTS=8
DOWNLOAD_DELAY=1.0
ROBOTSTXT_OBEY=true
PLAYWRIGHT_HEADLESS=true

# Website Audit & Rate-Limiting (Politeness)
PAGESPEED_API_KEY=
AUDIT_REQUEST_DELAY_MS=500
AUDIT_INTER_DOMAIN_DELAY_S=2.0

# Pipeline Health Monitoring & Alerts (Telegram / Slack / Email)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
ALERT_EMAIL=

# IMAP & Email Deliverability (Bounce Detection & Inbound Sync)
IMAP_HOST=mail.nexidant.com
IMAP_PORT=993
IMAP_USERNAME=info@nexidant.com
IMAP_PASSWORD=
SMTP_HOST=mail.nexidant.com
SMTP_PORT=587
SMTP_USER=info@nexidant.com
SMTP_PASSWORD=

# Decision Maker Enrichment & Verification
HUNTER_API_KEY=
APOLLO_API_KEY=
ZEROBOUNCE_API_KEY=

# Sales Outreach & CAN-SPAM Compliance
SENDER_NAME=Supto
COMPANY_PHYSICAL_ADDRESS="Nexidiant Software, 123 Tech Way, Suite 400, New York, NY 10001"
UNSUBSCRIBE_BASE_URL="https://nexidant.com/unsubscribe?email="
