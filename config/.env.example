# ==============================================================================
# Nexidant Signal — Environment Configuration
# ==============================================================================

# Database (MySQL / MariaDB — VPS native aaPanel setup)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nexidant_signal

# Redis (Deduplication, Tier-2 Crawl Queue & Worker Queues)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Proxies (Bright Data / Smartproxy residential pools)
USE_PROXIES=false
PROXY_URL=

# Scrapy & Crawling Settings
CONCURRENT_REQUESTS=8
DOWNLOAD_DELAY=1.0
ROBOTSTXT_OBEY=true
PLAYWRIGHT_HEADLESS=true

# Phase 2 — Website Audit (Google PageSpeed Insights)
PAGESPEED_API_KEY=

# Phase 4 — Decision Maker Enrichment & Verification
HUNTER_API_KEY=
APOLLO_API_KEY=
ZEROBOUNCE_API_KEY=

# Phase 5 — Sales Outreach & CAN-SPAM Compliance
SENDER_NAME=Supto
COMPANY_PHYSICAL_ADDRESS="Nexidiant Software, 123 Tech Way, Suite 400, New York, NY 10001"
UNSUBSCRIBE_BASE_URL="https://nexidiant.com/unsubscribe?email="
